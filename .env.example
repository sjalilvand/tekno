# =====================================================================
#  نمونه فایل .env — سامانه راه زندگی
#  این فایل را به «.env» تغییر نام دهید و مقادیر را تنظیم کنید.
# =====================================================================

# --- دیتابیس (یک گزینه را انتخاب کنید) ---
# توسعه (SQLite):
DATABASE_URL="file:./db/custom.db"
# تولید (MySQL واقعی):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# --- سرور ---
NODE_ENV="production"
PORT="3000"

# --- پیامک واقعی (اختیاری — می‌توانید از پنل «یکپارچه‌سازی‌ها» تنظیم کنید) ---
# سرویس‌دهنده: kavenegar | smsir | mellipayamak | soha | mock
SMS_PROVIDER="mock"
SMS_ENABLED="false"
SMS_API_KEY=""
SMS_SENDER=""
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_BASE_URL=""

# --- وب‌سرویس سها (اختیاری — می‌توانید از پنل تنظیم کنید) ---
SOHA_ENABLED="false"
SOHA_BASE_URL=""
SOHA_USERNAME=""
SOHA_PASSWORD=""
SOHA_API_KEY=""
SOHA_CENTER_CODE=""
SOHA_PROTOCOL="rest"
