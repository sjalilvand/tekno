// =====================================================================
//  سامانه مراکز خدمات روانشناسی و مشاوره «راه زندگی» — نسخه بازنویسی
//  طراحی‌شده بر اساس ساختار واقعی دیتابیس MySQL (app2_backup — 75 جدول)
//
//  نکات سازگاری:
//  • این اسکیما با SQLite (محیط دمو/توسعه) و MySQL (محیط تولید) کار می‌کند.
//  • از انواع پرتابل (String/Int/Float/DateTime/Boolean) استفاده شده تا
//    با تغییر فقط provider، روی MySQL واقعی مستقر شود.
//  • فیلدهای JSON در نسخه اصلی (EventsEms و ...) به‌صورت String ذخیره می‌شوند.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// جغرافیا و لیست‌های پایه
// ---------------------------------------------------------------------

model Province {
  id         Int     @id
  title      String
  apiCode    Int?    @map("API")
  detailCode Int?
  cities     City[]
  centers    Center[]
  users      User[]
  budgetProvinces BudgetProvince[]

  @@map("Provinces")
}

model City {
  id         Int      @id
  provinceId Int
  title      String
  apiCode    Int?     @map("APICode")
  province   Province @relation(fields: [provinceId], references: [id])
  centers    Center[]

  @@map("Cities")
}

model Education {
  id    Int    @id
  name  String
  users User[]

  @@map("Education")
}

model Marriage {
  id    Int    @id
  name  String
  users User[]

  @@map("Marriage")
}

model Religion {
  id   Int    @id
  name String

  @@map("Religion")
}

model Service {
  id     Int     @id
  name   String
  short  String
  sohaId Int
  weight Float   @default(1)
  events Event[]
  referrs Referr[]

  @@map("Services")
}

// ---------------------------------------------------------------------
// نقش‌ها، کاربران و دسترسی‌ها
// ---------------------------------------------------------------------

model Role {
  id          Int        @id
  title       String
  codeName    String
  permissions String? // JSON — کلیدهای دسترسی؛ خالی/null یعنی دسترسی کامل (سازگاری با گذشته)
  users       UserRole[]

  @@map("Roles")
}

model User {
  id             Int       @id @default(autoincrement())
  nid            BigInt    @unique
  username       String    @unique
  passwordHash   String
  name           String
  family         String
  father         String?
  gender         String?   // مرد / زن
  birthday       DateTime?
  marriageId     Int?
  marriage       Marriage? @relation(fields: [marriageId], references: [id])
  educationId    Int?
  education      Education? @relation(fields: [educationId], references: [id])
  religion       String?
  mobile         BigInt
  mobile2        BigInt?
  phone          Int?
  email          String?
  provinceId     Int?
  province       Province? @relation(fields: [provinceId], references: [id])
  cityId         Int?
  address        String?
  zipCode        BigInt?
  signupDate     DateTime  @default(now())
  lastLogin      DateTime?
  lastChangePass DateTime?
  confirm        Int?      @default(0)
  blocked        Boolean   @default(false)
  checked        Boolean   @default(false)
  avatarColor    String?   // رنگ آواتار تولیدشده
  consultantLevel Int?     // سطح ۱ تا ۵ برای مشاوران
  bio            String?

  roles          UserRole[]
  eventsAsClient Event[]    @relation("EventClient")
  eventsAsAcceptor Event[]  @relation("EventAcceptor")
  eventsAsSupervisor Event[] @relation("EventSupervisor")
  eventsAsCenterAdmin Event[] @relation("EventCenterAdmin")
  smsSent        Sms[]       @relation("SmsSender")
  smsReceived    Sms[]       @relation("SmsReceiver")
  logs           Log[]
  sessions       Session[]
  messagesFrom   Message[]   @relation("MsgFrom")
  messagesTo     Message[]   @relation("MsgTo")
  taxes          ConsultantTax[]
  tickets        UserTicket[]

  @@index([signupDate])
  @@index([gender])
  @@index([marriageId])
  @@index([educationId])
  @@index([mobile])
  @@map("Users")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  roleId      Int
  role        Role     @relation(fields: [roleId], references: [id])
  roleOption  Int      @default(0)
  level       Int      @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  confirmDate DateTime?
  addedBy     Int?
  isSuspended Boolean  @default(false)

  @@index([userId])
  @@map("UserRoles")
}

model Session {
  id       String   @id @default(cuid())
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  // یونیک حذف شد — دادهٔ legacy توکن تکراری/خالی دارد (انتقال SQLite→MySQL)
  token    String
  ip       String?
  browser  String?
  dateTime DateTime @default(now())

  @@index([token])
  @@map("Sessions")
}

model Log {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  category    String
  description String?
  level       Int      @default(1)
  ip          String?
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@map("Log")
}

// ---------------------------------------------------------------------
// مراکز
// ---------------------------------------------------------------------

model CenterCategory {
  id      Int      @id
  title   String
  centers Center[]
}

model Center {
  id          Int            @id
  title       String
  isEnabled   Boolean        @default(true)
  address     String?
  tel         String?
  catId       Int?
  category    CenterCategory? @relation(fields: [catId], references: [id])
  cityId      Int
  city        City           @relation(fields: [cityId], references: [id])
  cityTitle   String
  provinceId  Int
  province    Province       @relation(fields: [provinceId], references: [id])
  provinceTitle String
  events      Event[]
  bankAccounts CenterBankAccount[]
  equipments  CenterEquipment[]

  @@index([provinceId])
  @@map("Centers")
}

model CenterBankAccount {
  id       Int    @id @default(autoincrement())
  centerId Int
  center   Center @relation(fields: [centerId], references: [id])
  bankName String?
  sheba    String?
  accountNo String?
  ownerName String?

  @@map("CenterBankAccount")
}

model EquipmentItem {
  id    Int    @id
  title String
}

model CenterEquipment {
  id              Int           @id @default(autoincrement())
  centerId        Int
  center          Center        @relation(fields: [centerId], references: [id])
  equipmentItemId Int
  count           Int           @default(1)

  @@map("CenterEquipments")
}

// ---------------------------------------------------------------------
// قراردادهای سازمانی و تعرفه‌ها
// ---------------------------------------------------------------------

model CorporateCustomer {
  id       Int                 @id @default(autoincrement())
  title    String
  discount Int                 @default(0)
  phone    String?
  contracts CorporateContract[]

  @@map("CorporateCustomers")
}

model CorporateContract {
  id                  Int               @id @default(autoincrement())
  corporateCustomerId Int
  customer            CorporateCustomer @relation(fields: [corporateCustomerId], references: [id])
  appDefault          Boolean           @default(false)
  startDate           DateTime
  endDate             DateTime
  removed             Boolean           @default(false)
  services            CorporateContractService[]

  @@map("CorporateContracts")
}

model CorporateContractService {
  id                  Int               @id @default(autoincrement())
  corporateContractId Int
  contract            CorporateContract @relation(fields: [corporateContractId], references: [id])
  serviceId           Int
  userTariff          Int               @default(0)
  consultantLevel1    Int               @default(0)
  consultantLevel2    Int               @default(0)
  consultantLevel3    Int               @default(0)
  consultantLevel4    Int               @default(0)
  consultantLevel5    Int               @default(0)
  consultantDR        Int               @default(0)
  secretaryFee        Int               @default(0)
  supervisorFee       Int               @default(0)
  centerFee           Int               @default(0)
  adminFee            Int               @default(0)

  @@map("CorporateContractServices")
}

model CorporateContractCoupon {
  id       String  @id
  contractId Int
  used     Boolean @default(false)
}

// ---------------------------------------------------------------------
// سهمیه‌ها (بودجه) و تخصیص‌ها
// ---------------------------------------------------------------------

model Budget {
  id           Int       @id @default(autoincrement())
  title        String
  kind         String    @default("فردی") // فردی / گروهی / شغلی
  amount       Float     @default(0)
  remained     Float     @default(0)
  reserved     Float     @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createTime   DateTime  @default(now())
  used         Float     @default(0)
  assigned     Float     @default(0)
  isActive     Boolean   @default(true)
  provinces    BudgetProvince[]

  @@map("Budget")
}

model BudgetProvince {
  id        Int     @id @default(autoincrement())
  budgetId  Int
  budget    Budget  @relation(fields: [budgetId], references: [id])
  provinceId Int
  province  Province @relation(fields: [provinceId], references: [id])
  amount    Float   @default(0)
  remained  Float   @default(0)
  reserved  Float   @default(0)
  used      Float   @default(0)
  assigned  Float   @default(0)
  createTime DateTime @default(now())

  @@map("BudgetProvince")
}

model BudgetCity {
  id         Int   @id @default(autoincrement())
  budgetId   Int
  provinceId Int
  cityId     Int
  amount     Float @default(0)
  remained   Float @default(0)
  reserved   Float @default(0)
  used       Float @default(0)

  @@map("BudgetCity")
}

model BudgetCenter {
  id       Int   @id @default(autoincrement())
  budgetId Int
  centerId Int
  amount   Float @default(0)
  remained Float @default(0)
  reserved Float @default(0)
  used     Float @default(0)

  @@map("BudgetCenter")
}

// ---------------------------------------------------------------------
// جلسات مشاوره (Events) و فرم‌های بالینی
// ---------------------------------------------------------------------

model Event {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation("EventClient", fields: [userId], references: [id])
  nid            BigInt
  // یونیک حذف شد — دادهٔ legacy کد رهگیری تکراری (مثل 0) دارد
  trackingCode   Int?
  centerId       Int
  center         Center    @relation(fields: [centerId], references: [id])
  serviceId      Int
  service        Service   @relation(fields: [serviceId], references: [id])
  contractId     Int?
  refId          BigInt?
  emdadCheck     Boolean   @default(false)
  contractServiceId Int?
  userTariff     Int       @default(0)
  isEms          Boolean   @default(false)
  level          Int       @default(1)      // سطح مشاور
  centerAdminId  Int?
  centerAdmin    User?     @relation("EventCenterAdmin", fields: [centerAdminId], references: [id])
  supervisorId   Int?
  supervisor     User?     @relation("EventSupervisor", fields: [supervisorId], references: [id])
  acceptorId     Int?
  acceptor       User?     @relation("EventAcceptor", fields: [acceptorId], references: [id])
  acceptorFee    Int       @default(0)
  secretaryFee   Int       @default(0)
  acceptorCodeName String?
  acceptorLevel  Int       @default(1)
  supervisorFee  Int       @default(0)
  centerFee      Int       @default(0)
  adminFee       Int       @default(0)
  centerAdminConfirmUserId   Int?
  centerAdminConfirmDateTime DateTime?
  centerTechConfirmUserId    Int?
  centerTechConfirmDateTime  DateTime?
  operatorConfirmUserId      Int?
  operatorConfirmDateTime    DateTime?
  provinceSupervisorConfirmUserId    Int?
  provinceSupervisorConfirmDateTime  DateTime?
  supervisorConfirmUserId    Int?
  supervisorConfirmDateTime  DateTime?
  startDate      DateTime?
  endDate        DateTime?
  weight         Float     @default(1)
  budgetUsed     Boolean   @default(false)
  budgetReserved Boolean   @default(false)
  status         String    @default("در انتظار پذیرش")
  // در انتظار پذیرش | در انتظار تایید مدیر مرکز | در انتظار تایید مسئول فنی |
  // در انتظار تایید نظارت حرفه‌ای | در انتظار تایید ناظر استان | تایید نهایی | رد شده | ناتمام
  rejectedByUserId Int?
  rejectedAt       DateTime?
  rejectedComment  String?
  topic            String?   // موضوع جلسه (EventPersonal)
  description      String?   // شرح جلسه (EventPersonal)
  isGroup          Boolean   @default(false)
  groupEventId     Int?

  comments     EventComment[]
  reserves     EventReserve[]
  psychology   EventPsychology?
  // روابط یک‌به‌چند — در دادهٔ legacy چند فرم برای یک جلسه ثبت شده است
  neuroFeedback EventNeuroFeedback[]
  headMap      EventHeadMap[]
  ems          EventsEms[]
  medicines    EventMedicine[]
  disorders    EventDisorder[]

  @@index([userId])
  @@index([acceptorId])
  @@index([startDate])
  @@index([status])
  @@index([serviceId])
  @@index([centerId])
  @@index([trackingCode])
  @@map("Events")
}

model EventComment {
  id            Int      @id @default(autoincrement())
  eventId       Int
  event         Event    @relation(fields: [eventId], references: [id])
  consultantNID BigInt
  comment       String?
  dateTime      DateTime @default(now())

  @@index([eventId])
  @@map("EventComments")
}

model EventReserve {
  id         Int      @id @default(autoincrement())
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id])
  userId     Int
  acceptorId Int
  date       DateTime
  @@index([date])

  @@index([eventId])
  @@map("EventReserves")
}

model EventPsychology {
  id                   Int      @id @default(autoincrement())
  eventId              Int      @unique
  event                Event    @relation(fields: [eventId], references: [id])
  userId               Int?
  acceptorId           Int?
  job                  String?
  ethnicity            String?
  religion             String?
  religiousBelief      String?
  children             Int?
  residenceQuality     String?
  spouseInfo           String?
  problemStart         String?
  problemDuration      String?
  clinicalObservation  String?
  appearance           String?
  psychomotorStatus    String?
  interviewAttitude    String?
  mood                 String?
  affect               String?
  speech               String?
  perception           String?
  thoughtContent       String?
  thoughtProcess       String?
  consciousness        String?
  orientation          String?
  memory               String?
  concentration        String?
  intelligence         String?
  judgment             String?
  insight              String?
  medicalHistory       String?
  familyHistory        String?
  familyRelationships  String?
  dateTime             DateTime @default(now())

  @@map("EventPsychology")
}

model EventNeuroFeedback {
  id             Int      @id @default(autoincrement())
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id])
  protocol       String?
  target         String?
  visible        String?
  action         String?
  changed        String?
  ezterabOld     Int?
  ezterabNew     Int?
  afsorOld       Int?
  afsorNew       Int?
  sleepProblemOld Int?
  sleepProblemNew Int?
  focusOld       Int?
  focusNew       Int?
  energyOld      Int?
  energyNew      Int?
  other          String?
  dateTime       DateTime @default(now())

  // یونیک حذف شد — در دادهٔ legacy چند فرم نوروفیدبک برای یک جلسه ثبت شده
  @@index([eventId])
  @@map("EventNeuroFeedback")
}

model EventHeadMap {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id])
  fileId      Int?
  description String?
  dateTime    DateTime @default(now())

  // یونیک حذف شد — در دادهٔ legacy چند نقشهٔ سر برای یک جلسه ثبت شده
  @@index([eventId])
  @@map("EventHeadMap")
}

model EventMedicine {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id])
  name     String
  dosage   String?
  duration String?

  @@map("EventMedicine")
}

model EventDisorder {
  id         Int    @id @default(autoincrement())
  eventId    Int
  event      Event  @relation(fields: [eventId], references: [id])
  disorderId Int
  title      String

  @@map("EventDisorders")
}

model EventReferral {
  id            Int      @id @default(autoincrement())
  eventId       Int
  fromUserId    Int
  toUserId      Int
  reason        String?
  dateTime      DateTime @default(now())
}

// ---------------------------------------------------------------------
// جلسات گروهی
// ---------------------------------------------------------------------

model Group {
  id                  Int      @id @default(autoincrement())
  title               String
  corporateContractId Int?
  centerId            Int
  acceptorId          Int
  creatorId           Int?
  tel                 String?
  address             String?
  createDate          DateTime @default(now())
  members             GroupMember[]
  events              GroupEvent[]

  @@map("Groups")
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  userId    Int
  nid       BigInt
  refId     BigInt?
  dateTime  DateTime @default(now())

  @@index([groupId])
  @@map("GroupMembers")
}

model GroupEvent {
  id               Int       @id @default(autoincrement())
  groupId          Int
  group            Group     @relation(fields: [groupId], references: [id])
  topic            String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  sessionNumber    Int       @default(1)
  acceptorId       Int?
  acceptorCodeName String?
  acceptorLevel    Int       @default(1)
  supervisorId     Int?
  centerAdminId    Int?
  acceptorFee      Int       @default(0)
  secretaryFee     Int       @default(0)
  serviceId        Int?
  contractId       Int?
  userTariff       Int       @default(0)
  budgetReserved   Boolean   @default(false)
  budgetUsed       Boolean   @default(false)
  weight           Float     @default(1)
  centerId         Int?
  operatorConfirmUserId   Int?
  operatorConfirmDateTime DateTime?
  supervisorConfirmUserId Int?
  supervisorConfirmDateTime DateTime?
  status           String    @default("در انتظار تایید")
  members          GroupEventMember[]

  @@index([groupId])
  @@index([startDate])
  @@index([centerId])
  @@index([status])
  @@map("GroupEvents")
}

model GroupEventMember {
  id           Int     @id @default(autoincrement())
  userId       Int
  groupId      Int
  groupEventId Int?
  groupEvent   GroupEvent? @relation(fields: [groupEventId], references: [id])
  serviceId    Int?
  trackingCode Int?
  refId        BigInt?
  dateTime     DateTime   @default(now())

  @@map("GroupEventMember")
}

// ---------------------------------------------------------------------
// ارجاعات سها و درخواست‌های رزرو
// ---------------------------------------------------------------------

model Referr {
  id              Int      @id @default(autoincrement())
  refId           BigInt   @unique
  userId          Int
  userName        String?
  userNid         BigInt?
  userMobile      BigInt?
  serviceId       Int
  service         Service  @relation(fields: [serviceId], references: [id])
  description     String?
  isReferr        Boolean  @default(false)
  provinceId      Int
  cityId          Int?
  centerId        Int?
  acceptorId      Int?
  adminReferrerId Int?
  sessionsCount   Int      @default(0)
  status          String   @default("در انتظار") // در انتظار | پذیرش‌شده | ارجاع‌شده | منقضی
  creationDate    DateTime @default(now())
  followUps       ReferrFollowUp[]

  @@index([status])
  @@index([creationDate])
  @@index([provinceId])
  @@map("Referrs")
}

model ReferrFollowUp {
  id        Int      @id @default(autoincrement())
  referrId  Int
  referr    Referr   @relation(fields: [referrId], references: [id])
  userId    Int
  comment   String
  createdAt DateTime @default(now())

  @@map("ReferrFollowUps")
}

model ReferrRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  userName        String?
  description     String?
  provinceId      Int
  cityId          Int?
  centerId        Int?
  adminReferrerId Int?
  status          String   @default("در انتظار بررسی") // در انتظار بررسی | تایید شده | رد شده
  creationDate    DateTime @default(now())
  editionDate     DateTime?

  @@map("ReferrsRequest")
}

// ---------------------------------------------------------------------
// موارد حاد (EMS)
// ---------------------------------------------------------------------

model EventsEms {
  id                    Int      @id @default(autoincrement())
  eventId               Int
  event                 Event    @relation(fields: [eventId], references: [id])
  secretaryNID          BigInt?
  emsType               String?  // JSON — انواع مورد حاد
  suicidalFrom          String?  // JSON — عوامل خودکشی
  psychiatricDisorders  String?  // JSON
  socialFactors         String?  // JSON
  protectiveFactors     String?  // JSON
  suggestedActions      String?  // JSON
  actionsTaken          String?
  financialAssistanceRequest Int  @default(0)
  dateTime              DateTime @default(now())
  hadPaymentAmount      BigInt   @default(0)
  hadPaymentStatus      String?  // بدون درخواست | در انتظار بررسی | تایید شده | پرداخت شده
  hadPaymentDescription String?
  confirmedByUserId     Int?
  severity              String   @default("متوسط") // کم | متوسط | بالا
  comments              EventEmsComment[]

  // یونیک حذف شد — در دادهٔ legacy چند فرم EMS برای یک جلسه ثبت شده
  @@index([eventId])
  @@index([severity])
  @@index([hadPaymentStatus])
  @@map("EventsEms")
}

model EventEmsComment {
  id         Int      @id @default(autoincrement())
  eventEmsId Int
  ems        EventsEms @relation(fields: [eventEmsId], references: [id])
  userId     Int?
  comment    String
  date       DateTime @default(now())

  @@map("EventEmsComments")
}

// ---------------------------------------------------------------------
// مشاوران: تحصیلات، دوره‌ها، تجربه و مالیات
// ---------------------------------------------------------------------

model ConsultantEducation {
  id              Int      @id @default(autoincrement())
  userId          Int
  consultantNID   BigInt?
  field           String?
  orientation     String?
  grade           String?
  university      String?
  graduationDate  String?
  dateTime        DateTime @default(now())
  file            String?

  @@map("ConsultantEducation")
}

model ConsultantCourse {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  institute     String?
  hours         Int?
  year          String?
  dateTime      DateTime @default(now())

  @@map("ConsultantCourses")
}

model ConsultantExperience {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String
  place      String?
  fromYear   String?
  toYear     String?

  @@map("ConsultantExperience")
}

model ConsultantTax {
  id                 Int      @id @default(autoincrement())
  userId             Int?
  user               User?    @relation(fields: [userId], references: [id])
  nid                BigInt
  year               Int
  month              Int
  taxAmount          BigInt   @default(0)
  exemptionMonths    Int      @default(0)
  multiEmployerMonth Int      @default(0)
  multiEmployerYear  Int      @default(0)
  totalPayment       BigInt   @default(0)
  createdByUserId    Int?
  createdAt          DateTime @default(now())

  @@index([year, month])
  @@map("ConsultantTax")
}

// ---------------------------------------------------------------------
// پیامک، پیام، فایل و اعلان
// ---------------------------------------------------------------------

model Sms {
  id          Int      @id @default(autoincrement())
  senderId    Int
  sender      User     @relation("SmsSender", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User     @relation("SmsReceiver", fields: [receiverId], references: [id])
  number      BigInt?
  message     String
  response    String?
  efforts     Int      @default(0)
  status      String   @default("ارسال شده") // در صف | ارسال شده | ناموفق
  updateTime  DateTime @default(now())
  createTime  DateTime @default(now())

  @@index([createTime])
  @@index([status])
  @@map("SMS")
}

model Message {
  id                Int      @id @default(autoincrement())
  fromUserId        Int
  fromUser          User     @relation("MsgFrom", fields: [fromUserId], references: [id])
  toUserId          Int?
  toUser            User?    @relation("MsgTo", fields: [toUserId], references: [id])
  subject           String?
  text              String?
  fileId            Int?
  targetRole        String?
  targetProvinceId  Int?
  timestamp         DateTime @default(now())
  star              Boolean  @default(false)
  isRead            Boolean  @default(false)

  @@map("Messages")
}

model File {
  id             Int      @id @default(autoincrement())
  userNID        BigInt
  name           String
  location       String
  uploadDateTime DateTime @default(now())

  @@map("Files")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("Notifications")
}

// ---------------------------------------------------------------------
// تنظیمات، مناسبت‌ها، تیکت و راهنما
// ---------------------------------------------------------------------

model Setting {
  name   String  @id
  value  String?
  group  String  @default("عمومی")

  @@map("Settings")
}

model SpecialOccasion {
  id             Int      @id @default(autoincrement())
  title          String
  imagePath      String?
  displayDate    DateTime
  isActive       Boolean  @default(true)
  createdByUserId Int?
  createdAt      DateTime @default(now())

  @@map("SpecialOccasions")
}

model UserTicket {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  text        String?
  status      String   @default("باز") // باز | در حال بررسی | بسته
  priority    String   @default("متوسط")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("UserTicket")
}

model Help {
  id       Int    @id @default(autoincrement())
  roleId   Int?
  title    String
  fileUrl  String?

  @@map("Helps")
}

model ApiToken {
  id        Int      @id @default(autoincrement())
  title     String
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("ApiTokens")
}

model ApiReport {
  id         Int      @id @default(autoincrement())
  type       String
  data       String?
  efforts    Int      @default(0)
  status     String   @default("موفق")
  createTime DateTime @default(now())
  updateTime DateTime?

  @@map("ApiReports")
}

// ---------------------------------------------------------------------
// یکپارچه‌سازی‌ها — ثبت اجرای عملیات وب‌سرویس سها و پیامک واقعی
// ---------------------------------------------------------------------

model SyncLog {
  id         Int      @id @default(autoincrement())
  service    String   // SOHA | SMS | ...
  entity     String   // Patients | Referrals | Services | Queue
  direction  String   @default("IN") // IN (دریافت از سها) | OUT (ارسال به سها)
  status     String   @default("در حال اجرا") // در حال اجرا | موفق | ناموفق
  records    Int      @default(0)
  cursor     String?  // نشانگر افزایشی — آخرین زمان/شناسه همگام‌سازی
  message    String?  // خلاصه یا پیام خطا
  duration   Int?     // مدت اجرا (میلی‌ثانیه)
  createTime DateTime @default(now())

  @@index([service, entity, createTime])
  @@map("SyncLogs")
}

// =====================================================================
//  نسخهٔ ۶.۱ — دستیار هوشمند، کارتابل، فرم‌ساز، فرایند و تیک‌های هوشمند
// =====================================================================

// ---------------------------------------------------------------------
// چت آنلاین هوشمند — تاریخچهٔ گفتگو و پاسخ‌های ساختاریافته
// ---------------------------------------------------------------------

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String   // user | assistant
  text      String
  payload   String?  // JSON — نمودار / کارت‌ها / لینک‌های اکشن
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ChatMessages")
}

// ---------------------------------------------------------------------
// فرم‌ساز — تعریف فرم دلخواه و پاسخ‌های ثبت‌شده
// ---------------------------------------------------------------------

model FormDefinition {
  id          Int      @id @default(autoincrement())
  title       String
  desc        String?
  fields      String   // JSON — [{key,label,type,required,options}]
  isActive    Boolean  @default(true)
  createdBy   Int?
  createdAt   DateTime @default(now())
  submissions FormSubmission[]

  @@map("FormDefinitions")
}

model FormSubmission {
  id          Int            @id @default(autoincrement())
  formId      Int
  form        FormDefinition @relation(fields: [formId], references: [id])
  userId      Int?           // متقاضی مرتبط (اختیاری)
  eventId     Int?           // جلسهٔ مرتبط (اختیاری)
  data        String         // JSON — مقادیر فیلدها
  createdById Int?
  createdAt   DateTime       @default(now())

  @@index([formId])
  @@index([userId])
  @@map("FormSubmissions")
}

// ---------------------------------------------------------------------
// فرایندهای سفارشی — تعریف مرحله‌ها، نمونهٔ اجرا و ثبت زمان مرحله‌ها
// (مانیتورینگ و شبیه‌سازی هر درخواست بر همین پایه ساخته می‌شود)
// ---------------------------------------------------------------------

model ProcessDefinition {
  id        Int               @id @default(autoincrement())
  key       String            @unique
  title     String
  desc      String?
  bpmnFile  String?           // فایل BPMN مرتبط در public/bpmn (اختیاری)
  steps     String            // JSON — [{name, slaHours}]
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  instances ProcessInstance[]

  @@map("ProcessDefinitions")
}

model ProcessInstance {
  id          Int               @id @default(autoincrement())
  processId   Int
  process     ProcessDefinition @relation(fields: [processId], references: [id])
  refType     String            @default("Event") // Event | User | GroupEvent
  refId       Int
  title       String?           // برچسب نمایشی (نام متقاضی / کد پیگیری)
  currentStep Int               @default(0)
  status      String            @default("در جریان") // در جریان | تکمیل | متوقف
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  stepLogs    ProcessStepLog[]

  @@unique([processId, refType, refId])
  @@index([status])
  @@map("ProcessInstances")
}

model ProcessStepLog {
  id          Int             @id @default(autoincrement())
  instanceId  Int
  instance    ProcessInstance @relation(fields: [instanceId], references: [id])
  stepIdx     Int
  name        String
  enteredAt   DateTime        @default(now())
  exitedAt    DateTime?
  durationMin Int?
  note        String?

  @@index([instanceId])
  @@map("ProcessStepLogs")
}

// ---------------------------------------------------------------------
// تیک‌های هوشمند — الگوهای چک‌لیست و اجراهای هوشمند با تیک خودکار
// ---------------------------------------------------------------------

model ChecklistTemplate {
  id        Int            @id @default(autoincrement())
  key       String         @unique
  title     String
  desc      String?
  trigger   String         @default("manual") // new_client | acute | approval_stuck | manual
  items     String         // JSON — [{title, autoRule}]
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  runs      ChecklistRun[]

  @@map("ChecklistTemplates")
}

model ChecklistRun {
  id          Int               @id @default(autoincrement())
  templateId  Int
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  userId      Int?              // متقاضی مرتبط
  eventId     Int?              // جلسهٔ مرتبط
  title       String?           // برچسب نمایشی
  status      String            @default("در جریان") // در جریان | تکمیل
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  items       ChecklistRunItem[]

  @@index([userId])
  @@index([status])
  @@map("ChecklistRuns")
}

model ChecklistRunItem {
  id       Int          @id @default(autoincrement())
  runId    Int
  run      ChecklistRun @relation(fields: [runId], references: [id])
  title    String
  autoRule String?      // قاعدهٔ تیک خودکار
  done     Boolean      @default(false)
  auto     Boolean      @default(false)
  doneAt   DateTime?
  doneById Int?

  @@index([runId])
  @@map("ChecklistRunItems")
}
// ---------------------------------------------------------------------
// وب‌سرویس‌ساز و به‌روزرسانی داده — نسخهٔ ۶.۲
// ---------------------------------------------------------------------

model WebService {
  id         Int       @id @default(autoincrement())
  slug       String    @unique // آدرس: /api/ws/<slug>
  title      String
  sourceType String    @default("table") // table | sql — سرویس جدولی یا پرس‌وجویی
  sqlText    String?   // متن SELECT برای سرویس‌های پرس‌وجویی (استودیوی پرس‌وجو)
  table      String // نام جدول مجاز از کاتالوگ
  columns    String // JSON: ["id","name", ...] — خالی یعنی همهٔ ستون‌های مجاز
  filters    String? // JSON: [{col,op,value}]
  format     String    @default("json") // json | xml | csv
  authType   String    @default("apikey") // none | apikey
  apiKey     String?
  rowLimit   Int       @default(1000)
  orderBy    String?
  isActive   Boolean   @default(true)
  callCount  Int       @default(0)
  lastCallAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("WebServices")
}

model ImportJob {
  id         Int       @id @default(autoincrement())
  source     String // مسیر فایل پشتیبان روی سرور
  mode       String    @default("append") // append (ادغام با به‌روزرسانی) | truncate (پاک و جایگزین)
  status     String    @default("queued") // queued | running | done | failed
  progress   Int       @default(0)
  tablesDone Int       @default(0)
  tablesAll  Int       @default(0)
  log        String?
  byUserId   Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("ImportJobs")
}
