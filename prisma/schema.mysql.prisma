// =====================================================================
//  سامانه مراکز خدمات روانشناسی و مشاوره «راه زندگی» — نسخه بازنویسی
//  طراحی‌شده بر اساس ساختار واقعی دیتابیس MySQL (app2_backup — 75 جدول)
//
//  نکات سازگاری:
//  • این اسکیما با SQLite (محیط دمو/توسعه) و MySQL (محیط تولید) کار می‌کند.
//  • از انواع پرتابل (String/Int/Float/DateTime/Boolean) استفاده شده تا
//    با تغییر فقط provider، روی MySQL واقعی مستقر شود.
//  • فیلدهای JSON در نسخه اصلی (EventsEms و ...) به‌صورت String ذخیره می‌شوند.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// جغرافیا و لیست‌های پایه
// ---------------------------------------------------------------------

model Province {
  id         Int     @id
  title      String @db.Text
  apiCode    Int?    @map("API")
  detailCode Int?
  cities     City[]
  centers    Center[]
  users      User[]
  userRoles  UserRole[]

  @@map("Provinces")
}

model City {
  id         Int      @id
  provinceId Int
  title      String @db.Text
  apiCode    Int?     @map("APICode")
  province   Province @relation(fields: [provinceId], references: [id])
  centers    Center[]

  @@map("Cities")
}

model Education {
  id    Int    @id
  name  String @db.Text
  users User[]

  @@map("Education")
}

model Marriage {
  id    Int    @id
  name  String @db.Text
  users User[]

  @@map("Marriage")
}

model Religion {
  id   Int    @id
  name String @db.Text

  @@map("Religion")
}

model Service {
  id     Int     @id
  name   String @db.Text
  short  String @db.Text
  sohaId Int
  weight Float   @default(1)
  events Event[]
  referrs Referr[]

  @@map("Services")
}

// ---------------------------------------------------------------------
// نقش‌ها، کاربران و دسترسی‌ها
// ---------------------------------------------------------------------

model Role {
  id          Int        @id
  title       String @db.Text
  codeName    String @db.Text
  permissions String? @db.Text   // JSON — کلیدهای دسترسی؛ خالی/null یعنی دسترسی کامل (سازگاری با گذشته)
  // دامنهٔ داده (نسخهٔ ۶.۱۰) — چه نوع داده‌ای را ببیند؟
  // null = خودکار (مطابق گذشته: مشاور فقط خودش، بقیه همه) | all | province | center | self
  dataScope   String? @db.Text
  users       UserRole[]

  @@map("Roles")
}

model User {
  id             Int       @id @default(autoincrement())
  nid            BigInt    @unique
  username       String    @unique
  passwordHash   String @db.Text
  name           String @db.Text
  family         String @db.Text
  father         String? @db.Text
  gender         String?   // مرد / زن
  birthday       DateTime?
  marriageId     Int?
  marriage       Marriage? @relation(fields: [marriageId], references: [id])
  educationId    Int?
  education      Education? @relation(fields: [educationId], references: [id])
  religion       String? @db.Text
  mobile         BigInt
  mobile2        BigInt?
  phone          Int?
  email          String? @db.Text
  provinceId     Int?
  province       Province? @relation(fields: [provinceId], references: [id])
  cityId         Int?
  address        String? @db.Text
  zipCode        BigInt?
  signupDate     DateTime  @default(now())
  lastLogin      DateTime?
  lastChangePass DateTime?
  confirm        Int?      @default(0)
  blocked        Boolean   @default(false)
  checked        Boolean   @default(false)
  avatarColor    String? @db.Text   // رنگ آواتار تولیدشده
  consultantLevel Int?     // سطح ۱ تا ۵ برای مشاوران
  bio            String? @db.Text

  roles          UserRole[]
  psychAttempts  PsychTestAttempt[] @relation("PsychAttemptUser")
  trainingAttempts TrainingAttempt[] @relation("TrainingAttemptUser")
  eventsAsClient Event[]    @relation("EventClient")
  eventsAsAcceptor Event[]  @relation("EventAcceptor")
  eventsAsSupervisor Event[] @relation("EventSupervisor")
  eventsAsCenterAdmin Event[] @relation("EventCenterAdmin")
  smsSent        Sms[]       @relation("SmsSender")
  smsReceived    Sms[]       @relation("SmsReceiver")
  logs           Log[]
  sessions       Session[]
  messagesFrom   Message[]   @relation("MsgFrom")
  messagesTo     Message[]   @relation("MsgTo")
  taxes          ConsultantTax[]
  centerLinks    UserCenter[]

  @@index([signupDate])
  @@index([gender])
  @@index([marriageId])
  @@index([educationId])
  @@index([mobile])
  @@map("Users")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  roleId      Int
  role        Role     @relation(fields: [roleId], references: [id])
  roleOption  Int      @default(0)
  level       Int      @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  confirmDate DateTime?
  addedBy     Int?
  isSuspended Boolean  @default(false)
  // محدودهٔ دادهٔ این انتساب (نسخهٔ ۶.۱۰) — برای نقش‌های استانی/مرکزی
  provinceId  Int?
  province    Province? @relation(fields: [provinceId], references: [id])
  centerId    Int?
  center      Center?   @relation(fields: [centerId], references: [id])

  @@index([userId])
  @@map("UserRoles")
}

// ---------------------------------------------------------------------
// عضویت کاربر (مشاور/منشی/مدیر) در مراکز — یک مشاور می‌تواند همزمان
// در چند کلینیک کار کند و دادهٔ هر کلینیک جداگانه قابل مشاهده باشد (نسخهٔ ۶.۱۰)
// ---------------------------------------------------------------------
model UserCenter {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  centerId  Int
  center    Center  @relation(fields: [centerId], references: [id])
  isPrimary Boolean @default(false)

  @@unique([userId, centerId])
  @@map("UserCenters")
}

model Session {
  id       String   @id @default(cuid())
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  // یونیک حذف شد — دادهٔ legacy توکن تکراری/خالی دارد (انتقال SQLite→MySQL)
  token    String
  ip       String? @db.Text
  browser  String? @db.Text
  dateTime DateTime @default(now())

  @@index([token])
  @@map("Sessions")
}

model Log {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  category    String @db.Text
  description String? @db.Text
  level       Int      @default(1)
  ip          String? @db.Text
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@map("Log")
}

// ---------------------------------------------------------------------
// مراکز
// ---------------------------------------------------------------------

model CenterCategory {
  id      Int      @id
  title   String @db.Text
  centers Center[]
}

model Center {
  id          Int            @id
  title       String @db.Text
  isEnabled   Boolean        @default(true)
  address     String? @db.Text
  tel         String? @db.Text
  catId       Int?
  category    CenterCategory? @relation(fields: [catId], references: [id])
  cityId      Int
  city        City           @relation(fields: [cityId], references: [id])
  cityTitle   String @db.Text
  provinceId  Int
  province    Province       @relation(fields: [provinceId], references: [id])
  provinceTitle String @db.Text
  postalCode  String? @db.Text
  managerName String? @db.Text
  managerPhone String? @db.Text
  workingHours String? @db.Text
  latitude    Float?
  longitude   Float?
  mapUrl      String? @db.Text
  events      Event[]
  bankAccounts CenterBankAccount[]
  equipments  CenterEquipment[]
  staff       UserCenter[]
  userRoles   UserRole[]

  @@index([provinceId])
  @@map("Centers")
}

model CenterBankAccount {
  id       Int    @id @default(autoincrement())
  centerId Int
  center   Center @relation(fields: [centerId], references: [id])
  bankName String? @db.Text
  sheba    String? @db.Text
  accountNo String? @db.Text
  ownerName String? @db.Text

  @@map("CenterBankAccount")
}

model EquipmentItem {
  id    Int    @id
  title String @db.Text
}

model CenterEquipment {
  id              Int           @id @default(autoincrement())
  centerId        Int
  center          Center        @relation(fields: [centerId], references: [id])
  equipmentItemId Int
  count           Int           @default(1)

  @@map("CenterEquipments")
}

// ---------------------------------------------------------------------
// قراردادهای سازمانی و تعرفه‌ها
// ---------------------------------------------------------------------

model CorporateCustomer {
  id       Int                 @id @default(autoincrement())
  title    String @db.Text
  discount Int                 @default(0)
  phone    String? @db.Text
  contracts CorporateContract[]

  @@map("CorporateCustomers")
}

model CorporateContract {
  id                  Int               @id @default(autoincrement())
  corporateCustomerId Int
  customer            CorporateCustomer @relation(fields: [corporateCustomerId], references: [id])
  appDefault          Boolean           @default(false)
  startDate           DateTime
  endDate             DateTime
  removed             Boolean           @default(false)
  services            CorporateContractService[]

  @@map("CorporateContracts")
}

model CorporateContractService {
  id                  Int               @id @default(autoincrement())
  corporateContractId Int
  contract            CorporateContract @relation(fields: [corporateContractId], references: [id])
  serviceId           Int
  userTariff          Int               @default(0)
  consultantLevel1    Int               @default(0)
  consultantLevel2    Int               @default(0)
  consultantLevel3    Int               @default(0)
  consultantLevel4    Int               @default(0)
  consultantLevel5    Int               @default(0)
  consultantDR        Int               @default(0)
  secretaryFee        Int               @default(0)
  supervisorFee       Int               @default(0)
  centerFee           Int               @default(0)
  adminFee            Int               @default(0)

  @@map("CorporateContractServices")
}

model CorporateContractCoupon {
  id       String  @id
  contractId Int
  used     Boolean @default(false)
}

// ---------------------------------------------------------------------
// سهمیه‌ها (بودجه) و تخصیص‌ها
// ---------------------------------------------------------------------

model Budget {
  id           Int       @id @default(autoincrement())
  title        String @db.Text
  kind         String    @default("فردی") // فردی / گروهی / شغلی
  amount       Float     @default(0)
  remained     Float     @default(0)
  reserved     Float     @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createTime   DateTime  @default(now())
  used         Float     @default(0)
  assigned     Float     @default(0)
  isActive     Boolean   @default(true)
  provinces    BudgetProvince[]

  @@map("Budget")
}

model BudgetProvince {
  id        Int     @id @default(autoincrement())
  budgetId  Int
  budget    Budget  @relation(fields: [budgetId], references: [id])
  provinceId Int
  amount    Float   @default(0)
  remained  Float   @default(0)
  reserved  Float   @default(0)
  used      Float   @default(0)
  assigned  Float   @default(0)
  createTime DateTime @default(now())

  @@map("BudgetProvince")
}

model BudgetCity {
  id         Int   @id @default(autoincrement())
  budgetId   Int
  provinceId Int
  cityId     Int
  amount     Float @default(0)
  remained   Float @default(0)
  reserved   Float @default(0)
  used       Float @default(0)

  @@map("BudgetCity")
}

model BudgetCenter {
  id       Int   @id @default(autoincrement())
  budgetId Int
  centerId Int
  amount   Float @default(0)
  remained Float @default(0)
  reserved Float @default(0)
  used     Float @default(0)

  @@map("BudgetCenter")
}

// ---------------------------------------------------------------------
// جلسات مشاوره (Events) و فرم‌های بالینی
// ---------------------------------------------------------------------

model Event {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation("EventClient", fields: [userId], references: [id])
  nid            BigInt
  trackingCode   Int?
  centerId       Int
  center         Center    @relation(fields: [centerId], references: [id])
  serviceId      Int
  service        Service   @relation(fields: [serviceId], references: [id])
  contractId     Int?
  refId          BigInt?
  emdadCheck     Boolean   @default(false)
  contractServiceId Int?
  userTariff     Int       @default(0)
  isEms          Boolean   @default(false)
  level          Int       @default(1)      // سطح مشاور
  centerAdminId  Int?
  centerAdmin    User?     @relation("EventCenterAdmin", fields: [centerAdminId], references: [id])
  supervisorId   Int?
  supervisor     User?     @relation("EventSupervisor", fields: [supervisorId], references: [id])
  acceptorId     Int?
  acceptor       User?     @relation("EventAcceptor", fields: [acceptorId], references: [id])
  acceptorFee    Int       @default(0)
  secretaryFee   Int       @default(0)
  acceptorCodeName String? @db.Text
  acceptorLevel  Int       @default(1)
  supervisorFee  Int       @default(0)
  centerFee      Int       @default(0)
  adminFee       Int       @default(0)
  centerAdminConfirmUserId   Int?
  centerAdminConfirmDateTime DateTime?
  centerTechConfirmUserId    Int?
  centerTechConfirmDateTime  DateTime?
  operatorConfirmUserId      Int?
  operatorConfirmDateTime    DateTime?
  provinceSupervisorConfirmUserId    Int?
  provinceSupervisorConfirmDateTime  DateTime?
  supervisorConfirmUserId    Int?
  supervisorConfirmDateTime  DateTime?
  startDate      DateTime?
  endDate        DateTime?
  weight         Float     @default(1)
  budgetUsed     Boolean   @default(false)
  budgetReserved Boolean   @default(false)
  status         String    @default("در انتظار پذیرش")
  // در انتظار پذیرش | در انتظار تایید مدیر مرکز | در انتظار تایید مسئول فنی |
  // در انتظار تایید نظارت حرفه‌ای | در انتظار تایید ناظر استان | تایید نهایی | رد شده | ناتمام
  rejectedByUserId Int?
  rejectedAt       DateTime?
  rejectedComment  String? @db.Text
  topic            String? @db.Text   // موضوع جلسه (EventPersonal)
  description      String? @db.Text   // شرح جلسه (EventPersonal)
  isGroup          Boolean   @default(false)
  groupEventId     Int?

  comments     EventComment[]
  reserves     EventReserve[]
  psychology   EventPsychology?
  // روابط یک‌به‌چند — در دادهٔ legacy چند فرم برای یک جلسه ثبت شده است
  neuroFeedback EventNeuroFeedback[]
  headMap      EventHeadMap[]
  ems          EventsEms[]
  medicines    EventMedicine[]
  disorders    EventDisorder[]

  @@index([userId])
  @@index([acceptorId])
  @@index([startDate])
  @@index([status])
  @@index([serviceId])
  @@index([centerId])
  @@index([trackingCode])
  @@map("Events")
}

model EventComment {
  id            Int      @id @default(autoincrement())
  eventId       Int
  event         Event    @relation(fields: [eventId], references: [id])
  consultantNID BigInt
  comment       String? @db.Text
  dateTime      DateTime @default(now())

  @@index([eventId])
  @@map("EventComments")
}

model EventReserve {
  id         Int      @id @default(autoincrement())
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id])
  userId     Int
  acceptorId Int
  date       DateTime
  @@index([date])

  @@index([eventId])
  @@map("EventReserves")
}

model EventPsychology {
  id                   Int      @id @default(autoincrement())
  eventId              Int      @unique
  event                Event    @relation(fields: [eventId], references: [id])
  userId               Int?
  acceptorId           Int?
  job                  String? @db.Text
  ethnicity            String? @db.Text
  religion             String? @db.Text
  religiousBelief      String? @db.Text
  children             Int?
  residenceQuality     String? @db.Text
  spouseInfo           String? @db.Text
  problemStart         String? @db.Text
  problemDuration      String? @db.Text
  clinicalObservation  String? @db.Text
  appearance           String? @db.Text
  psychomotorStatus    String? @db.Text
  interviewAttitude    String? @db.Text
  mood                 String? @db.Text
  affect               String? @db.Text
  speech               String? @db.Text
  perception           String? @db.Text
  thoughtContent       String? @db.Text
  thoughtProcess       String? @db.Text
  consciousness        String? @db.Text
  orientation          String? @db.Text
  memory               String? @db.Text
  concentration        String? @db.Text
  intelligence         String? @db.Text
  judgment             String? @db.Text
  insight              String? @db.Text
  medicalHistory       String? @db.Text
  familyHistory        String? @db.Text
  familyRelationships  String? @db.Text
  dateTime             DateTime @default(now())

  @@map("EventPsychology")
}

model EventNeuroFeedback {
  id             Int      @id @default(autoincrement())
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id])
  protocol       String? @db.Text
  target         String? @db.Text
  visible        String? @db.Text
  action         String? @db.Text
  changed        String? @db.Text
  ezterabOld     Int?
  ezterabNew     Int?
  afsorOld       Int?
  afsorNew       Int?
  sleepProblemOld Int?
  sleepProblemNew Int?
  focusOld       Int?
  focusNew       Int?
  energyOld      Int?
  energyNew      Int?
  other          String? @db.Text
  dateTime       DateTime @default(now())

  // یونیک حذف شد — در دادهٔ legacy چند فرم نوروفیدبک برای یک جلسه ثبت شده
  @@index([eventId])
  @@map("EventNeuroFeedback")
}

model EventHeadMap {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id])
  fileId      Int?
  description String? @db.Text
  dateTime    DateTime @default(now())

  // یونیک حذف شد — در دادهٔ legacy چند نقشهٔ سر برای یک جلسه ثبت شده
  @@index([eventId])
  @@map("EventHeadMap")
}

model EventMedicine {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id])
  name     String @db.Text
  dosage   String? @db.Text
  duration String? @db.Text

  @@map("EventMedicine")
}

model EventDisorder {
  id         Int    @id @default(autoincrement())
  eventId    Int
  event      Event  @relation(fields: [eventId], references: [id])
  disorderId Int
  title      String @db.Text

  @@map("EventDisorders")
}

model EventReferral {
  id            Int      @id @default(autoincrement())
  eventId       Int
  fromUserId    Int
  toUserId      Int
  reason        String? @db.Text
  dateTime      DateTime @default(now())
}

// ---------------------------------------------------------------------
// جلسات گروهی
// ---------------------------------------------------------------------

model Group {
  id                  Int      @id @default(autoincrement())
  title               String @db.Text
  corporateContractId Int?
  centerId            Int
  acceptorId          Int
  creatorId           Int?
  tel                 String? @db.Text
  address             String? @db.Text
  createDate          DateTime @default(now())
  members             GroupMember[]
  events              GroupEvent[]

  @@map("Groups")
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  userId    Int
  nid       BigInt
  refId     BigInt?
  dateTime  DateTime @default(now())

  @@index([groupId])
  @@map("GroupMembers")
}

model GroupEvent {
  id               Int       @id @default(autoincrement())
  groupId          Int
  group            Group     @relation(fields: [groupId], references: [id])
  topic            String @db.Text
  description      String? @db.Text
  startDate        DateTime?
  endDate          DateTime?
  sessionNumber    Int       @default(1)
  acceptorId       Int?
  acceptorCodeName String? @db.Text
  acceptorLevel    Int       @default(1)
  supervisorId     Int?
  centerAdminId    Int?
  acceptorFee      Int       @default(0)
  secretaryFee     Int       @default(0)
  serviceId        Int?
  contractId       Int?
  userTariff       Int       @default(0)
  budgetReserved   Boolean   @default(false)
  budgetUsed       Boolean   @default(false)
  weight           Float     @default(1)
  centerId         Int?
  operatorConfirmUserId   Int?
  operatorConfirmDateTime DateTime?
  supervisorConfirmUserId Int?
  supervisorConfirmDateTime DateTime?
  status           String    @default("در انتظار تایید")
  members          GroupEventMember[]

  @@index([groupId])
  @@index([startDate])
  @@index([centerId])
  @@index([status])
  @@map("GroupEvents")
}

model GroupEventMember {
  id           BigInt     @id @default(autoincrement())
  userId       Int
  groupId      Int
  groupEventId Int?
  groupEvent   GroupEvent? @relation(fields: [groupEventId], references: [id])
  serviceId    Int?
  trackingCode Int?
  refId        BigInt?
  dateTime     DateTime   @default(now())

  @@map("GroupEventMember")
}

// ---------------------------------------------------------------------
// ارجاعات سها و درخواست‌های رزرو
// ---------------------------------------------------------------------

model Referr {
  id              Int      @id @default(autoincrement())
  refId           BigInt   @unique
  userId          Int
  userName        String? @db.Text
  userNid         BigInt?
  userMobile      BigInt?
  serviceId       Int
  service         Service  @relation(fields: [serviceId], references: [id])
  description     String? @db.Text
  isReferr        Boolean  @default(false)
  provinceId      Int
  cityId          Int?
  centerId        Int?
  acceptorId      Int?
  adminReferrerId Int?
  sessionsCount   Int      @default(0)
  status          String   @default("در انتظار") // در انتظار | پذیرش‌شده | ارجاع‌شده | منقضی
  creationDate    DateTime @default(now())
  followUps       ReferrFollowUp[]

  @@index([status])
  @@index([creationDate])
  @@index([provinceId])
  @@map("Referrs")
}

model ReferrFollowUp {
  id        Int      @id @default(autoincrement())
  referrId  Int
  referr    Referr   @relation(fields: [referrId], references: [id])
  userId    Int
  comment   String @db.Text
  createdAt DateTime @default(now())

  @@map("ReferrFollowUps")
}

model ReferrRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  userName        String? @db.Text
  description     String? @db.Text
  provinceId      Int
  cityId          Int?
  centerId        Int?
  adminReferrerId Int?
  status          String   @default("در انتظار بررسی") // در انتظار بررسی | تایید شده | رد شده
  creationDate    DateTime @default(now())
  editionDate     DateTime?

  @@map("ReferrsRequest")
}

// ---------------------------------------------------------------------
// موارد حاد (EMS)
// ---------------------------------------------------------------------

model EventsEms {
  id                    Int      @id @default(autoincrement())
  eventId               Int
  event                 Event    @relation(fields: [eventId], references: [id])
  secretaryNID          BigInt?
  emsType               String? @db.Text   // JSON — انواع مورد حاد
  suicidalFrom          String? @db.Text   // JSON — عوامل خودکشی
  psychiatricDisorders  String? @db.Text   // JSON
  socialFactors         String? @db.Text   // JSON
  protectiveFactors     String? @db.Text   // JSON
  suggestedActions      String? @db.Text   // JSON
  actionsTaken          String? @db.Text
  financialAssistanceRequest Int  @default(0)
  dateTime              DateTime @default(now())
  hadPaymentAmount      BigInt   @default(0)
  hadPaymentStatus      String?  // بدون درخواست | در انتظار بررسی | تایید شده | پرداخت شده
  hadPaymentDescription String? @db.Text
  confirmedByUserId     Int?
  severity              String   @default("متوسط") // کم | متوسط | بالا
  comments              EventEmsComment[]

  // یونیک حذف شد — در دادهٔ legacy چند فرم EMS برای یک جلسه ثبت شده
  @@index([eventId])
  @@index([severity])
  @@index([hadPaymentStatus])
  @@map("EventsEms")
}

