// ---------------------------------------------------------------------
// یکپارچه‌سازی‌ها — ثبت اجرای عملیات وب‌سرویس سها و پیامک واقعی
// ---------------------------------------------------------------------

model SyncLog {
  id         Int      @id @default(autoincrement())
  service    String   // SOHA | SMS | ...
  entity     String   // Patients | Referrals | Services | Queue
  direction  String   @default("IN") // IN (دریافت از سها) | OUT (ارسال به سها)
  status     String   @default("در حال اجرا") // در حال اجرا | موفق | ناموفق
  records    Int      @default(0)
  cursor     String? @db.Text   // نشانگر افزایشی — آخرین زمان/شناسه همگام‌سازی
  message    String? @db.Text   // خلاصه یا پیام خطا
  duration   Int?     // مدت اجرا (میلی‌ثانیه)
  createTime DateTime @default(now())

  @@index([service, entity, createTime])
  @@map("SyncLogs")
}

// =====================================================================
//  نسخهٔ ۶.۱ — دستیار هوشمند، کارتابل، فرم‌ساز، فرایند و تیک‌های هوشمند
// =====================================================================

// ---------------------------------------------------------------------
// چت آنلاین هوشمند — تاریخچهٔ گفتگو و پاسخ‌های ساختاریافته
// ---------------------------------------------------------------------

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String @db.Text   // user | assistant
  text      String @db.Text
  payload   String? @db.MediumText   // JSON — نمودار / کارت‌ها / لینک‌های اکشن
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ChatMessages")
}

// ---------------------------------------------------------------------
// فرم‌ساز — تعریف فرم دلخواه و پاسخ‌های ثبت‌شده
// ---------------------------------------------------------------------

model FormDefinition {
  id          Int      @id @default(autoincrement())
  title       String @db.Text
  desc        String? @db.Text
  fields      String @db.MediumText   // JSON — [{key,label,type,required,options}]
  isActive    Boolean  @default(true)
  createdBy   Int?
  createdAt   DateTime @default(now())
  submissions FormSubmission[]

  @@map("FormDefinitions")
}

model FormSubmission {
  id          Int            @id @default(autoincrement())
  formId      Int
  form        FormDefinition @relation(fields: [formId], references: [id])
  userId      Int?           // متقاضی مرتبط (اختیاری)
  eventId     Int?           // جلسهٔ مرتبط (اختیاری)
  data        String @db.MediumText   // JSON — مقادیر فیلدها
  createdById Int?
  createdAt   DateTime       @default(now())

  @@index([formId])
  @@index([userId])
  @@map("FormSubmissions")
}

// ---------------------------------------------------------------------
// فرایندهای سفارشی — تعریف مرحله‌ها، نمونهٔ اجرا و ثبت زمان مرحله‌ها
// (مانیتورینگ و شبیه‌سازی هر درخواست بر همین پایه ساخته می‌شود)
// ---------------------------------------------------------------------

model ProcessDefinition {
  id        Int               @id @default(autoincrement())
  key       String            @unique
  title     String @db.Text
  desc      String? @db.Text
  bpmnFile  String? @db.Text   // فایل BPMN مرتبط در public/bpmn (اختیاری)
  steps     String @db.Text   // JSON — [{name, slaHours}]
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  instances ProcessInstance[]

  @@map("ProcessDefinitions")
}

model ProcessInstance {
  id          Int               @id @default(autoincrement())
  processId   Int
  process     ProcessDefinition @relation(fields: [processId], references: [id])
  refType     String            @default("Event") // Event | User | GroupEvent
  refId       Int
  title       String? @db.Text   // برچسب نمایشی (نام متقاضی / کد پیگیری)
  currentStep Int               @default(0)
  status      String            @default("در جریان") // در جریان | تکمیل | متوقف
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  stepLogs    ProcessStepLog[]

  @@unique([processId, refType, refId])
  @@index([status])
  @@map("ProcessInstances")
}

model ProcessStepLog {
  id          Int             @id @default(autoincrement())
  instanceId  Int
  instance    ProcessInstance @relation(fields: [instanceId], references: [id])
  stepIdx     Int
  name        String @db.Text
  enteredAt   DateTime        @default(now())
  exitedAt    DateTime?
  durationMin Int?
  note        String? @db.Text

  @@index([instanceId])
  @@map("ProcessStepLogs")
}

// ---------------------------------------------------------------------
// تیک‌های هوشمند — الگوهای چک‌لیست و اجراهای هوشمند با تیک خودکار
// ---------------------------------------------------------------------

model ChecklistTemplate {
  id        Int            @id @default(autoincrement())
  key       String         @unique
  title     String @db.Text
  desc      String? @db.Text
  trigger   String         @default("manual") // new_client | acute | approval_stuck | manual
  items     String @db.MediumText   // JSON — [{title, autoRule}]
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  runs      ChecklistRun[]

  @@map("ChecklistTemplates")
}

model ChecklistRun {
  id          Int               @id @default(autoincrement())
  templateId  Int
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  userId      Int?              // متقاضی مرتبط
  eventId     Int?              // جلسهٔ مرتبط
  title       String? @db.Text   // برچسب نمایشی
  status      String            @default("در جریان") // در جریان | تکمیل
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  items       ChecklistRunItem[]

  @@index([userId])
  @@index([status])
  @@map("ChecklistRuns")
}

model ChecklistRunItem {
  id       Int          @id @default(autoincrement())
  runId    Int
  run      ChecklistRun @relation(fields: [runId], references: [id])
  title    String @db.Text
  autoRule String? @db.Text   // قاعدهٔ تیک خودکار
  done     Boolean      @default(false)
  auto     Boolean      @default(false)
  doneAt   DateTime?
  doneById Int?

  @@index([runId])
  @@map("ChecklistRunItems")
}
// ---------------------------------------------------------------------
// وب‌سرویس‌ساز و به‌روزرسانی داده — نسخهٔ ۶.۲
// ---------------------------------------------------------------------

model WebService {
  id         Int       @id @default(autoincrement())
  slug       String    @unique // آدرس: /api/ws/<slug>
  title      String @db.Text
  sourceType String    @default("table") // table | sql — سرویس جدولی یا پرس‌وجویی
  sqlText    String? @db.Text   // متن SELECT برای سرویس‌های پرس‌وجویی (استودیوی پرس‌وجو)
  table      String @db.Text   // نام جدول مجاز از کاتالوگ
  columns    String @db.MediumText   // JSON: ["id","name", ...] — خالی یعنی همهٔ ستون‌های مجاز
  filters    String? @db.MediumText   // JSON: [{col,op,value}]
  format     String    @default("json") // json | xml | csv
  authType   String    @default("apikey") // none | apikey
  apiKey     String? @db.Text
  rowLimit   Int       @default(1000)
  orderBy    String? @db.Text
  isActive   Boolean   @default(true)
  callCount  Int       @default(0)
  lastCallAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("WebServices")
}

model ImportJob {
  id         Int       @id @default(autoincrement())
  source     String @db.Text   // مسیر فایل پشتیبان روی سرور
  mode       String    @default("append") // append (ادغام با به‌روزرسانی) | truncate (پاک و جایگزین)
  status     String    @default("queued") // queued | running | done | failed
  progress   Int       @default(0)
  tablesDone Int       @default(0)
  tablesAll  Int       @default(0)
  log        String? @db.Text
  byUserId   Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("ImportJobs")
}

// ---------------------------------------------------------------------
// آزمون‌های روان‌شناختی، آموزش‌ها و حسابداری — نسخهٔ ۶.۱۲
// منبع محتوا: مخزن special-spoon (بانک آزمون‌ها + آموزش‌ها + کلینیک‌های رز)
// ---------------------------------------------------------------------

model PsychTest {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String @db.Text
  code            String? @db.Text
  topic           String    @default("عمومی")
  description     String? @db.Text
  ageRange        String? @db.Text
  minutes         Int?
  color           String    @default("#a83a54")
  sortOrder       Int       @default(999)
  questions       String @db.MediumText   // JSON: [{prompt,options:[[label,score]],subscale?,image?}]
  interpretations String? @db.MediumText   // JSON: [{scoreMin,scoreMax,label,guidance}]
  scales          String? @db.MediumText   // JSON: زیرمقیاس‌ها با سطوح تفسیر
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  attempts        PsychTestAttempt[]

  @@map("PsychTests")
}

model PsychTestAttempt {
  id             Int       @id @default(autoincrement())
  testId         Int
  test           PsychTest @relation(fields: [testId], references: [id])
  userId         Int // کاربر ثبت‌کننده (مشاور/خود فرد)
  user           User      @relation("PsychAttemptUser", fields: [userId], references: [id])
  subjectName    String? @db.Text   // نام آزمون‌دهنده — در صورت ثبت برای متقاضی
  subjectNid     BigInt? // کد ملی متقاضی
  answers        String @db.MediumText   // JSON: [optionIndex, ...]
  score          Int       @default(0)
  percent        Int       @default(0)
  resultLabel    String? @db.Text
  resultGuidance String? @db.Text
  subscores      String? @db.MediumText   // JSON: [{key,title,score,level,text}]
  createdAt      DateTime  @default(now())

  @@index([testId])
  @@index([userId])
  @@index([subjectNid])
  @@map("PsychTestAttempts")
}

model TrainingItem {
  id              Int       @id @default(autoincrement())
  kind            String    @default("content") // content | course | exam
  slug            String    @unique
  title           String @db.Text
  summary         String? @db.Text
  body            String? @db.Text
  topic           String? @db.Text
  tag             String? @db.Text
  price           Int       @default(0) // ریال — صفر = رایگان
  capacity        Int?
  startAt         DateTime?
  sessions        String? @db.MediumText   // JSON: [{title,durationMinutes}]
  questions       String? @db.MediumText   // JSON (kind=exam): [{prompt,options,correctIndex}]
  passPercent     Int       @default(60)
  durationMinutes Int       @default(20)
  status          String    @default("published") // draft | published
  createdBy       Int?
  createdAt       DateTime  @default(now())
  attempts        TrainingAttempt[]

  @@index([kind])
  @@map("TrainingItems")
}

model TrainingAttempt {
  id           Int          @id @default(autoincrement())
  itemId       Int
  item         TrainingItem @relation(fields: [itemId], references: [id])
  userId       Int
  user         User         @relation("TrainingAttemptUser", fields: [userId], references: [id])
  answers      String @db.Text   // JSON: [optionIndex, ...]
  scorePercent Int          @default(0)
  passed       Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([itemId])
  @@index([userId])
  @@map("TrainingAttempts")
}

model FinanceTransaction {
  id          Int      @id @default(autoincrement())
  kind        String // income | expense
  title       String @db.Text
  category    String   @default("عمومی")
  amount      BigInt
  method      String? @db.Text   // cash | card | transfer | cheque | online
  centerId    Int?
  eventId     Int?
  occurredAt  DateTime
  description String? @db.Text
  createdBy   Int?
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([centerId])
  @@index([occurredAt])
  @@map("FinanceTransactions")
}

