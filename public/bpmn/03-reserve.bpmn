                  id="Defs_reserve"
                  targetNamespace="http://raz.ir/bpmn">
  <bpmn:process id="Process_reserve" isExecutable="false">
    <bpmn:startEvent id="s" name="درخواست رزرو کاربر" />     <bpmn:task id="check" name="بررسی درخواست توسط مدیر مرکز" />     <bpmn:exclusiveGateway id="g_acc" name="پذیرش؟" />     <bpmn:task id="book" name="ثبت رزرو وقت و ارسال پیامک" />     <bpmn:exclusiveGateway id="g_show" name="حضور مراجع؟" />     <bpmn:task id="conv" name="تبدیل رزرو به جلسهٔ مشاوره" />     <bpmn:task id="follow" name="تماس پیگیری ۲۴ ساعت بعد" />     <bpmn:exclusiveGateway id="g2nd" name="رزرو مجدد؟" />     <bpmn:task id="cancel" name="بستن رزرو بی‌نتیجه" />     <bpmn:task id="reject" name="اعلام رد رزرو با دلیل" />     <bpmn:endEvent id="e_ok" name="جلسه قطعی شد" />     <bpmn:endEvent id="e_no" name="رزرو بسته شد" />     <bpmn:endEvent id="e_rej" name="درخواست رد شد" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="check" />     <bpmn:sequenceFlow id="Flow_2" sourceRef="check" targetRef="g_acc" />     <bpmn:sequenceFlow id="Flow_3" sourceRef="g_acc" targetRef="book" name="بله" />     <bpmn:sequenceFlow id="Flow_4" sourceRef="g_acc" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_5" sourceRef="reject" targetRef="e_rej" />     <bpmn:sequenceFlow id="Flow_6" sourceRef="book" targetRef="g_show" />     <bpmn:sequenceFlow id="Flow_7" sourceRef="g_show" targetRef="conv" name="بله" />     <bpmn:sequenceFlow id="Flow_8" sourceRef="conv" targetRef="e_ok" />     <bpmn:sequenceFlow id="Flow_9" sourceRef="g_show" targetRef="follow" name="خیر" />     <bpmn:sequenceFlow id="Flow_10" sourceRef="follow" targetRef="g2nd" />     <bpmn:sequenceFlow id="Flow_11" sourceRef="g2nd" targetRef="book" name="بله" />     <bpmn:sequenceFlow id="Flow_12" sourceRef="g2nd" targetRef="cancel" name="خیر" />     <bpmn:sequenceFlow id="Flow_13" sourceRef="cancel" targetRef="e_no" />
  </bpmn:process>
