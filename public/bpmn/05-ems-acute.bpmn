  <bpmn:process id="Process_emsacute" isExecutable="false">
    <bpmn:startEvent id="s" name="تشخیص مورد حاد" />     <bpmn:task id="form" name="ثبت فرم مورد حاد (EMS) توسط مشاور" />     <bpmn:exclusiveGateway id="g_risk" name="شدت خطر؟" />     <bpmn:task id="urgent" name="اقدام فوری و اطلاع به مسئولین" />     <bpmn:task id="review" name="بررسی در جلسهٔ بعد و برنامهٔ درمان" />     <bpmn:task id="low" name="پایش و مشاورهٔ تکمیلی" />     <bpmn:task id="act" name="ثبت اقدامات انجام‌شده" />     <bpmn:exclusiveGateway id="g_pay" name="درخواست کمک مالی؟" />     <bpmn:task id="pay" name="بررسی و تایید پرداخت کمک هزینه" />     <bpmn:task id="follow" name="پیگیری وضعیت مراجع" />     <bpmn:endEvent id="e_ok" name="پرونده بسته شد" />     <bpmn:endEvent id="e_pay" name="پرداخت انجام شد" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="form" />     <bpmn:sequenceFlow id="Flow_2" sourceRef="form" targetRef="g_risk" />     <bpmn:sequenceFlow id="Flow_3" sourceRef="g_risk" targetRef="urgent" name="بالا" />     <bpmn:sequenceFlow id="Flow_4" sourceRef="g_risk" targetRef="review" name="متوسط" />     <bpmn:sequenceFlow id="Flow_5" sourceRef="g_risk" targetRef="low" name="کم" />     <bpmn:sequenceFlow id="Flow_6" sourceRef="urgent" targetRef="act" />     <bpmn:sequenceFlow id="Flow_7" sourceRef="review" targetRef="act" />     <bpmn:sequenceFlow id="Flow_8" sourceRef="low" targetRef="act" />     <bpmn:sequenceFlow id="Flow_9" sourceRef="act" targetRef="g_pay" />     <bpmn:sequenceFlow id="Flow_10" sourceRef="g_pay" targetRef="pay" name="دارد" />     <bpmn:sequenceFlow id="Flow_11" sourceRef="g_pay" targetRef="follow" name="ندارد" />     <bpmn:sequenceFlow id="Flow_12" sourceRef="pay" targetRef="e_pay" />     <bpmn:sequenceFlow id="Flow_13" sourceRef="pay" targetRef="follow" />     <bpmn:sequenceFlow id="Flow_14" sourceRef="follow" targetRef="e_ok" />
