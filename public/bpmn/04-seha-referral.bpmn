                  id="Defs_sehareferral"
                  targetNamespace="http://raz.ir/bpmn">
  <bpmn:process id="Process_sehareferral" isExecutable="false">
    <bpmn:startEvent id="s" name="ارجاع از سامانهٔ سها" />     <bpmn:task id="recv" name="دریافت مشخصات و خدمت ارجاعی" />     <bpmn:exclusiveGateway id="g_ok" name="قابل پذیرش؟" />     <bpmn:task id="accept" name="پذیرش ارجاع و معرفی به مرکز" />     <bpmn:task id="assign" name="تعیین مشاور و برنامهٔ جلسات" />     <bpmn:task id="run" name="اجرای جلسات و ثبت گزارش" />     <bpmn:exclusiveGateway id="g_fin" name="تعداد جلسات تکمیل شد؟" />     <bpmn:task id="report" name="اعلام نتیجه و وضعیت به سها" />     <bpmn:task id="reject" name="ثبت دلیل عدم پذیرش" />     <bpmn:endEvent id="e_ok" name="ارجاع بسته شد" />     <bpmn:endEvent id="e_rej" name="ارجاع رد شد" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="recv" />     <bpmn:sequenceFlow id="Flow_2" sourceRef="recv" targetRef="g_ok" />     <bpmn:sequenceFlow id="Flow_3" sourceRef="g_ok" targetRef="accept" name="بله" />     <bpmn:sequenceFlow id="Flow_4" sourceRef="g_ok" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_5" sourceRef="reject" targetRef="e_rej" />     <bpmn:sequenceFlow id="Flow_6" sourceRef="accept" targetRef="assign" />     <bpmn:sequenceFlow id="Flow_7" sourceRef="assign" targetRef="run" />     <bpmn:sequenceFlow id="Flow_8" sourceRef="run" targetRef="g_fin" />     <bpmn:sequenceFlow id="Flow_9" sourceRef="g_fin" targetRef="run" name="خیر — ادامهٔ جلسات" />     <bpmn:sequenceFlow id="Flow_10" sourceRef="g_fin" targetRef="report" name="بله" />     <bpmn:sequenceFlow id="Flow_11" sourceRef="report" targetRef="e_ok" />
  </bpmn:process>
