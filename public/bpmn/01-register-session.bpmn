<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_registersession"
                  targetNamespace="http://raz.ir/bpmn">
  <bpmn:process id="Process_registersession" isExecutable="false">
    <bpmn:startEvent id="s" name="درخواست مراجع" />     <bpmn:task id="check" name="بررسی هویت و پروندهٔ مراجع" />     <bpmn:exclusiveGateway id="g_budget" name="سهمیه دارد؟" />     <bpmn:task id="budget" name="رزرو سهمیهٔ بودجه (فردی/گروهی/شغلی)" />     <bpmn:task id="no_budget" name="اعلام عدم امکان پذیرش به مراجع" />     <bpmn:task id="service" name="تعیین خدمت، مرکز و مشاور" />     <bpmn:task id="tariff" name="محاسبهٔ تعرفه و سهم‌های مالی" />     <bpmn:task id="reserve" name="ثبت رزرو وقت و اطلاع‌رسانی پیامکی" />     <bpmn:task id="session" name="برگزاری جلسه و ثبت پایان جلسه" />     <bpmn:endEvent id="e_ok" name="جلسه ثبت شد" />     <bpmn:endEvent id="e_no" name="درخواست رد شد" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="check" />     <bpmn:sequenceFlow id="Flow_2" sourceRef="check" targetRef="g_budget" />     <bpmn:sequenceFlow id="Flow_3" sourceRef="g_budget" targetRef="budget" name="دارد" />     <bpmn:sequenceFlow id="Flow_4" sourceRef="g_budget" targetRef="no_budget" name="ندارد" />     <bpmn:sequenceFlow id="Flow_5" sourceRef="no_budget" targetRef="e_no" />     <bpmn:sequenceFlow id="Flow_6" sourceRef="budget" targetRef="service" />     <bpmn:sequenceFlow id="Flow_7" sourceRef="service" targetRef="tariff" />     <bpmn:sequenceFlow id="Flow_8" sourceRef="tariff" targetRef="reserve" />     <bpmn:sequenceFlow id="Flow_9" sourceRef="reserve" targetRef="session" />     <bpmn:sequenceFlow id="Flow_10" sourceRef="session" targetRef="e_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_registersession">
    <bpmndi:BPMNPlane id="Plane_registersession" bpmnElement="Process_registersession">
        <bpmndi:BPMNShape id="Shape_s" bpmnElement="s">
          <dc:Bounds x="120" y="240" width="36" height="36" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="83" y="282" width="110" height="14" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_check" bpmnElement="check">
          <dc:Bounds x="300" y="240" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="304" y="256" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_g_budget" bpmnElement="g_budget">
          <dc:Bounds x="480" y="240" width="50" height="50" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="455" y="298" width="100" height="14" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_budget" bpmnElement="budget">
          <dc:Bounds x="660" y="110" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="664" y="126" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_no_budget" bpmnElement="no_budget">
          <dc:Bounds x="660" y="370" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="664" y="386" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_service" bpmnElement="service">
          <dc:Bounds x="840" y="110" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="844" y="126" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_tariff" bpmnElement="tariff">
          <dc:Bounds x="1020" y="110" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="1024" y="126" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_reserve" bpmnElement="reserve">
          <dc:Bounds x="1200" y="110" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="1204" y="126" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_session" bpmnElement="session">
          <dc:Bounds x="1380" y="110" width="100" height="80" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="1384" y="126" width="92" height="48" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_e_ok" bpmnElement="e_ok">
          <dc:Bounds x="1560" y="110" width="36" height="36" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="1523" y="152" width="110" height="14" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="Shape_e_no" bpmnElement="e_no">
          <dc:Bounds x="840" y="370" width="36" height="36" />
          <bpmndi:BPMNLabel>
            <dc:Bounds x="803" y="412" width="110" height="14" />
          </bpmndi:BPMNLabel>
        </bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
          <di:waypoint x="156" y="258" />           <di:waypoint x="228" y="258" />           <di:waypoint x="228" y="280" />           <di:waypoint x="300" y="280" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
          <di:waypoint x="400" y="280" />           <di:waypoint x="440" y="280" />           <di:waypoint x="440" y="265" />           <di:waypoint x="480" y="265" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
          <di:waypoint x="530" y="265" />           <di:waypoint x="595" y="265" />           <di:waypoint x="595" y="150" />           <di:waypoint x="660" y="150" />
          <bpmndi:BPMNLabel><dc:Bounds x="555" y="245" width="80" height="14" /></bpmndi:BPMNLabel>
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
          <di:waypoint x="530" y="265" />           <di:waypoint x="595" y="265" />           <di:waypoint x="595" y="410" />           <di:waypoint x="660" y="410" />
          <bpmndi:BPMNLabel><dc:Bounds x="555" y="245" width="80" height="14" /></bpmndi:BPMNLabel>
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
          <di:waypoint x="760" y="410" />           <di:waypoint x="800" y="410" />           <di:waypoint x="800" y="388" />           <di:waypoint x="840" y="388" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
          <di:waypoint x="760" y="150" />           <di:waypoint x="840" y="150" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
          <di:waypoint x="940" y="150" />           <di:waypoint x="1020" y="150" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
          <di:waypoint x="1120" y="150" />           <di:waypoint x="1200" y="150" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
          <di:waypoint x="1300" y="150" />           <di:waypoint x="1380" y="150" />
          
        </bpmndi:BPMNEdge>         <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
          <di:waypoint x="1480" y="150" />           <di:waypoint x="1520" y="150" />           <di:waypoint x="1520" y="128" />           <di:waypoint x="1560" y="128" />
          
        </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
