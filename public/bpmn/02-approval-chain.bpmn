                  id="Defs_approvalchain"
                  targetNamespace="http://raz.ir/bpmn">
  <bpmn:process id="Process_approvalchain" isExecutable="false">
    <bpmn:startEvent id="s" name="پایان جلسه مشاوره" />     <bpmn:task id="t1" name="بررسی و تایید مدیر مرکز" />     <bpmn:exclusiveGateway id="g1" name="تایید؟" />     <bpmn:task id="t2" name="بررسی و تایید مسئول فنی" />     <bpmn:exclusiveGateway id="g2" name="تایید؟" />     <bpmn:task id="t3" name="بررسی نظارت حرفه‌ای" />     <bpmn:exclusiveGateway id="g3" name="تایید؟" />     <bpmn:task id="t4" name="تایید ناظر استان" />     <bpmn:exclusiveGateway id="g4" name="تایید؟" />     <bpmn:task id="t5" name="تایید نهایی ناظر کشور" />     <bpmn:task id="settle" name="ثبت حقوق‌و‌دستمزد و تسویهٔ مشاور" />     <bpmn:task id="reject" name="اعلام رد با ذکر دلیل به مشاور" />     <bpmn:endEvent id="e_rej" name="جلسه رد شد" />     <bpmn:endEvent id="e_ok" name="تایید نهایی و تسویه" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t1" />     <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="g1" />     <bpmn:sequenceFlow id="Flow_3" sourceRef="g1" targetRef="t2" name="بله" />     <bpmn:sequenceFlow id="Flow_4" sourceRef="t2" targetRef="g2" />     <bpmn:sequenceFlow id="Flow_5" sourceRef="g2" targetRef="t3" name="بله" />     <bpmn:sequenceFlow id="Flow_6" sourceRef="t3" targetRef="g3" />     <bpmn:sequenceFlow id="Flow_7" sourceRef="g3" targetRef="t4" name="بله" />     <bpmn:sequenceFlow id="Flow_8" sourceRef="t4" targetRef="g4" />     <bpmn:sequenceFlow id="Flow_9" sourceRef="g4" targetRef="t5" name="بله" />     <bpmn:sequenceFlow id="Flow_10" sourceRef="t5" targetRef="settle" />     <bpmn:sequenceFlow id="Flow_11" sourceRef="settle" targetRef="e_ok" />     <bpmn:sequenceFlow id="Flow_12" sourceRef="g1" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_13" sourceRef="g2" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_14" sourceRef="g3" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_15" sourceRef="g4" targetRef="reject" name="خیر" />     <bpmn:sequenceFlow id="Flow_16" sourceRef="reject" targetRef="e_rej" />
